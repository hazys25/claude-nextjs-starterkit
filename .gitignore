# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 단, 공유용 템플릿(.env.example)은 추적한다 (실제 비밀값은 .env.local 에만 둔다)
!.env.example

# Claude Code (팀 공유 항목만 추적, settings.local 등 개인 설정은 제외)
# 주의: .gitignore 는 인라인 주석(줄 끝 #)을 지원하지 않으므로 주석은 항상 별도 줄에 둔다
.claude/*
!.claude/CLAUDE.md
# 아래 항목들은 팀과 공유 → 추적 (디렉터리 단위로 예외 처리해야 내부 파일이 추적됨)
# 서브에이전트 정의
!.claude/agents/
# 에이전트 누적 메모리(프로젝트 아키텍처·리뷰 패턴)
!.claude/agent-memory/
# 커스텀 슬래시 커맨드(git/docs/debug)
!.claude/commands/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
