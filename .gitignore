# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 단, 공유용 템플릿(.env.example)은 추적한다 (실제 비밀값은 .env.local 에만 둔다)
!.env.example

# Claude Code (프로젝트 표준 CLAUDE.md만 공유, 개인 설정은 제외)
.claude/*
!.claude/CLAUDE.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
